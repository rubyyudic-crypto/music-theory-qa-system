        "# Cell 3: Download System Code\n",
        "!wget -q https://raw.githubusercontent.com/rubyyudic-crypto/music-theory-qa-system/main/music_theory_qa_system_v2_optimized.py\n",
        "\n",
        "import music_theory_qa_system_v2_optimized as mqa\n",
        "print(\"✅ System loaded\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Cell 4: Create Sample Data\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "Path('data').mkdir(exist_ok=True)\n",
        "\n",
        "# Sample music theory text\n",
        "text = \"大三和弦由根音、大三度和纯五度组成。小三和弦由根音、小三度和纯五度组成。\"\n",
        "Path('data/music_theory.txt').write_text(text, encoding='utf-8')\n",
        "\n",
        "# Sample QA pairs\n",
        "qa = pd.DataFrame({\n",
        "    'Question': ['什么是大三和弦？', '什么是小三和弦？'],\n",
        "    'Answer': ['大三和弦由根音、大三度和纯五度组成。', '小三和弦由根音、小三度和纯五度组成。']\n",
        "})\n",
        "qa.to_excel('data/qa_pairs.xlsx', index=False)\n",
        "qa.to_excel('data/test_set.xlsx', index=False)\n",
        "\n",
        "print(\"✅ Sample data created\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Cell 5: Initialize System\n",
        "config = mqa.Config(\n",
        "    kb_text_files=['data/music_theory.txt'],\n",
        "    kb_excel_files=['data/qa_pairs.xlsx']\n",
        ")\n",
        "\n",
        "system = mqa.MusicQASystem(config)\n",
        "system.initialize()\n",
        "\n",
        "print(\"✅ System ready!\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Cell 6: Test QA\n",
        "questions = ['什么是大三和弦？', '小三和弦是什么？']\n",
        "\n",
        "for q in questions:\n",
        "    resp = system.answer(q)\n",
        "    print(f\"Q: {q}\")\n",
        "    print(f\"A: {resp.data['answer']}\\n\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Cell 7: Evaluate\n",
        "eval_resp = system.evaluate('data/test_set.xlsx')\n",
        "\n",
        "print(f\"EM: {eval_resp.data['exact_match']:.3f}\")\n",
        "print(f\"F1: {eval_resp.data['f1_score']:.3f}\")"
      ]
    }
  ]
}
